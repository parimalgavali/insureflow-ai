# copy to .env — docker compose reads it automatically
LLM_PROVIDER=anthropic            # anthropic | ollama | recorded
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b
DEMO_API_TOKEN=                   # required: the API refuses to start without it...
ALLOW_OPEN_API=1                  # ...unless this is 1 (local only; never on a public deployment)
ADJUSTER_API_TOKEN=                # required for claim review; never give it to policyholders
DATABASE_URL=postgresql+psycopg://claimpilot:claimpilot@localhost:5432/claimpilot
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
